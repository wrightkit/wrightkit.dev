{
  "name": "wrightkit.dev",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sync:installer": "node scripts/sync-installer.mjs",
    "dev": "node scripts/sync-installer.mjs && vite dev",
    "build": "node scripts/sync-installer.mjs && vite build && node scripts/verify-build.mjs",
    "preview": "vite preview",
    "check": "node scripts/sync-installer.mjs && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "svelte": "^5.56.9",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.1"
  }
}
